<Window x:Class="YTubeFetch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTubeFetch" Width="1050" Height="620"
        MinWidth="780" MinHeight="400"
        Icon="/Resources/YTubeFetch.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="DropPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Preferences" Click="Preferences_Click"
                          ToolTip="Configure download folders, video/audio quality, subtitle languages, and other settings"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"
                          ToolTip="Close YTubeFetch"/>
            </MenuItem>
            <MenuItem Header="_Actions">
                <MenuItem x:Name="StopOperationMenu" Header="_Stop Operation" Click="StopOperation_Click"
                          IsEnabled="False"
                          ToolTip="Cancel the current download and all queued jobs"/>
                <MenuItem x:Name="ResumeOperationMenu" Header="_Resume Operation" Click="ResumeOperation_Click"
                          IsEnabled="False"
                          ToolTip="Re-queue downloads that were stopped"/>
                <Separator/>
                <MenuItem Header="Open _Video Folder" Click="OpenVideoFolder_Click"
                          ToolTip="Open the folder where downloaded videos are saved"/>
                <MenuItem Header="Open _Audio Folder" Click="OpenAudioFolder_Click"
                          ToolTip="Open the folder where downloaded audio files are saved"/>
                <MenuItem Header="Open S_ubtitles Folder" Click="OpenSubsFolder_Click"
                          ToolTip="Open the folder where downloaded subtitles are saved"/>
                <Separator/>
                <MenuItem Header="_Update yt-dlp" Click="UpdateYtDlp_Click"
                          ToolTip="Download the latest version of yt-dlp. Do this if downloads fail or new YouTube changes break compatibility."/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_User Guide" Click="UserGuide_Click"
                          ToolTip="Open the user guide with detailed instructions on how to use YTubeFetch"/>
                <Separator/>
                <MenuItem Header="_About" Click="About_Click"
                          ToolTip="Version and application information"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="StatusText" Text="Ready"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Progress Bar (hidden when idle, green) -->
        <ProgressBar x:Name="ProgressBar" DockPanel.Dock="Bottom" Height="4" Minimum="0" Maximum="100"
                     Visibility="Collapsed" Foreground="#22AA22"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     BorderThickness="0"/>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="JobsColumn" Width="250" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="MiddleColumn" Width="300" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="LogColumn" Width="*" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Job List -->
            <DockPanel Grid.Column="0" Margin="4">
                <TextBlock DockPanel.Dock="Top" Text="Jobs" FontWeight="SemiBold" Margin="4,4,4,8"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ListBox x:Name="JobList" BorderThickness="1"
                         Background="{DynamicResource ListBackgroundBrush}"
                         BorderBrush="{DynamicResource ListBorderBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         PreviewMouseRightButtonDown="JobList_PreviewMouseRightButtonDown">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open File" Click="JobOpenFile_Click"/>
                            <MenuItem Header="Open Containing Folder" Click="JobOpenFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="Retry" Click="JobRetry_Click"/>
                            <MenuItem Header="Remove from List" Click="JobRemove_Click"/>
                            <MenuItem Header="Clear List" Click="JobClearList_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding TypeIcon}" Width="16" Height="16"
                                       Margin="0,0,4,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border Grid.Column="1" Width="48" Height="36" Margin="0,0,6,0"
                                        CornerRadius="3" ClipToBounds="True"
                                        BorderThickness="1.5" BorderBrush="{Binding ThumbnailBorderBrush}"
                                        Visibility="{Binding ThumbnailVisibility}"
                                        Background="{DynamicResource PanelBackgroundBrush}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Title}"
                                           ToolTip="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding StatusColor}"
                                           FontWeight="{Binding StatusWeight}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Splitter between Jobs and Drop panels -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Middle Panel: URL bar + Toggle Targets -->
            <DockPanel x:Name="DropArea" Grid.Column="2" Margin="4"
                       AllowDrop="True" Background="Transparent"
                       DragEnter="DropArea_DragEnter" DragLeave="DropArea_DragLeave"
                       Drop="DropArea_Drop">
                <DockPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Paste" Click="DropAreaPaste_Click"/>
                    </ContextMenu>
                </DockPanel.ContextMenu>

                <!-- URL Bar -->
                <Grid DockPanel.Dock="Top" Margin="4,0,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBar" Grid.Column="0" VerticalContentAlignment="Center"
                             Margin="0,0,4,0" KeyDown="UrlBar_KeyDown"
                             PreviewKeyDown="UrlBar_PreviewKeyDown"
                             TextChanged="UrlBar_TextChanged"
                             DataObject.Pasting="UrlBar_Pasting"/>
                    <Button x:Name="FetchButton" Grid.Column="1" Content="Fetch" Width="60"
                            IsEnabled="False" Click="FetchButton_Click"/>
                </Grid>

                <!-- Toggle Panels -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Video Toggle -->
                    <Border x:Name="VideoBorder" Grid.Row="0" Style="{StaticResource DropPanelStyle}"
                            MouseLeftButtonDown="VideoToggle_Click"
                            AllowDrop="True" DragEnter="DropArea_DragEnter" DragLeave="DropArea_DragLeave"
                            Drop="TogglePanel_Drop" Tag="Video">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Image Source="/Resources/Icons/video.png" Width="36" Height="36" Margin="0,0,0,4" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Video" FontSize="28" FontWeight="Light"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Audio Toggle -->
                    <Border x:Name="AudioBorder" Grid.Row="1" Style="{StaticResource DropPanelStyle}"
                            MouseLeftButtonDown="AudioToggle_Click"
                            AllowDrop="True" DragEnter="DropArea_DragEnter" DragLeave="DropArea_DragLeave"
                            Drop="TogglePanel_Drop" Tag="Audio">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Image Source="/Resources/Icons/audio.png" Width="36" Height="36" Margin="0,0,0,4" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Audio" FontSize="28" FontWeight="Light"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Subtitles Toggle -->
                    <Border x:Name="SubsBorder" Grid.Row="2" Style="{StaticResource DropPanelStyle}"
                            MouseLeftButtonDown="SubsToggle_Click"
                            AllowDrop="True" DragEnter="DropArea_DragEnter" DragLeave="DropArea_DragLeave"
                            Drop="TogglePanel_Drop" Tag="Subtitles">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Image Source="/Resources/Icons/subs.png" Width="36" Height="36" Margin="0,0,0,4" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Subtitles" FontSize="28" FontWeight="Light"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- Splitter between Drop panels and Log -->
            <GridSplitter x:Name="LogSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Right Panel: Live Log -->
            <DockPanel x:Name="LogPanel" Grid.Column="4" Margin="4">
                <Grid DockPanel.Dock="Top" Margin="4,4,4,8">
                    <TextBlock Text="Log" FontWeight="SemiBold"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button x:Name="ClearLogButton" Content="Clear"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="8,2" Click="ClearLog_Click"/>
                </Grid>
                <TextBox x:Name="LogViewer"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="11"
                         BorderThickness="1"
                         Background="{DynamicResource ListBackgroundBrush}"
                         BorderBrush="{DynamicResource ListBorderBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
