<Window x:Class="YTubeFetch.Views.PreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="/Resources/YTubeFetch.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- General Tab -->
            <TabItem Header="General">
                <StackPanel Margin="12">
                    <TextBlock Text="Video download folder:" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="VideoFolderBox" Grid.Column="0" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse..." Width="75"
                                Click="BrowseVideoFolder_Click"/>
                    </Grid>

                    <TextBlock Text="Audio download folder:" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AudioFolderBox" Grid.Column="0" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse..." Width="75"
                                Click="BrowseAudioFolder_Click"/>
                    </Grid>

                    <TextBlock Text="Subtitles download folder:" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SubsFolderBox" Grid.Column="0" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse..." Width="75"
                                Click="BrowseSubsFolder_Click"/>
                    </Grid>

                    <CheckBox x:Name="PrependDateCheck" Content="Prepend upload date to filenames"
                              Margin="0,0,0,8"/>
                    <CheckBox x:Name="MonitorClipboardCheck"
                              Content="Monitor clipboard for YouTube URLs"
                              Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShowLogPanelCheck"
                              Content="Show log panel"/>
                </StackPanel>
            </TabItem>

            <!-- Video Tab -->
            <TabItem Header="Video">
                <StackPanel Margin="12">
                    <TextBlock Text="Video quality:" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox x:Name="VideoQualityCombo" Margin="0,0,0,16" Width="200"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="Best Available" Tag="best"/>
                        <ComboBoxItem Content="1080p" Tag="1080"/>
                        <ComboBoxItem Content="720p" Tag="720"/>
                        <ComboBoxItem Content="480p" Tag="480"/>
                        <ComboBoxItem Content="360p" Tag="360"/>
                    </ComboBox>

                    <CheckBox x:Name="VideoOriginalAudioCheck"
                              Content="Prefer original audio over AI-dubbed"/>
                </StackPanel>
            </TabItem>

            <!-- Audio Tab -->
            <TabItem Header="Audio">
                <StackPanel Margin="12">
                    <TextBlock Text="Audio format:" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox x:Name="AudioFormatCombo" Margin="0,0,0,16" Width="200"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="MP3" Tag="mp3"/>
                        <ComboBoxItem Content="AAC" Tag="aac"/>
                        <ComboBoxItem Content="OGG" Tag="ogg"/>
                        <ComboBoxItem Content="OPUS" Tag="opus"/>
                        <ComboBoxItem Content="WAV" Tag="wav"/>
                    </ComboBox>

                    <TextBlock Text="Audio quality:" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox x:Name="AudioQualityCombo" Margin="0,0,0,16" Width="200"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="Best (VBR)" Tag="0"/>
                        <ComboBoxItem Content="320 kbps" Tag="320"/>
                        <ComboBoxItem Content="256 kbps" Tag="256"/>
                        <ComboBoxItem Content="192 kbps" Tag="192"/>
                        <ComboBoxItem Content="128 kbps" Tag="128"/>
                    </ComboBox>

                    <CheckBox x:Name="AudioOriginalAudioCheck"
                              Content="Prefer original audio over AI-dubbed"/>
                </StackPanel>
            </TabItem>

            <!-- Subtitles Tab -->
            <TabItem Header="Subtitles">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Preferred languages (in order):"
                               FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="LangList" Grid.Column="0"
                                 Background="{DynamicResource ListBackgroundBrush}"
                                 BorderBrush="{DynamicResource ListBorderBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                            <Button Content="Up" Width="75" Margin="0,0,0,4"
                                    Click="LangUp_Click"/>
                            <Button Content="Down" Width="75" Margin="0,0,0,4"
                                    Click="LangDown_Click"/>
                            <Button Content="Remove" Width="75" Margin="0,0,0,12"
                                    Click="LangRemove_Click"/>
                            <TextBox x:Name="LangAddBox" Width="75" Margin="0,0,0,4"
                                     MaxLength="5" VerticalContentAlignment="Center"/>
                            <Button Content="Add" Width="75"
                                    Click="LangAdd_Click"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="SubObsidianCheck" Grid.Row="2"
                              Content="Save subtitles in Obsidian format"
                              Margin="0,0,0,8"/>
                    <CheckBox x:Name="SubFallbackCheck" Grid.Row="3"
                              Content="Fallback to video's original language"
                              Margin="0,0,0,8"/>
                    <CheckBox x:Name="SubPreferManualCheck" Grid.Row="4"
                              Content="Prefer manual over auto-generated"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0"
                    IsDefault="True" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
