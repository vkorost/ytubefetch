<Window x:Class="YTubeFetch.Views.UserGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTubeFetch User Guide"
        Width="680" Height="740"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="/Resources/YTubeFetch.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <FlowDocumentScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsToolBarVisible="False">
            <FlowDocument x:Name="GuideDocument" FontFamily="Segoe UI" FontSize="13"
                          PagePadding="12,8,12,8" LineHeight="20"/>
        </FlowDocumentScrollViewer>

        <Button Grid.Row="1" Content="Close" Width="90" HorizontalAlignment="Right"
                Margin="0,12,0,0" IsDefault="True" IsCancel="True"/>
    </Grid>
</Window>
